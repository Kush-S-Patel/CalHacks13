# Anthropic — five Claude agents (CFO, Risk, Procurement, Collections, Cashier)
ANTHROPIC_API_KEY=sk-ant-...

# SpacetimeDB
SPACETIMEDB_URI=http://127.0.0.1:3000
SPACETIMEDB_DB=swarmcfo
SPACETIMEDB_MODULE_PATH=./spacetime

# Next.js
NEXT_PUBLIC_AGENT_API=http://127.0.0.1:8765
NEXT_PUBLIC_SPACETIMEDB_URI=http://127.0.0.1:3000
NEXT_PUBLIC_SPACETIMEDB_DB=swarmcfo
NEXT_PUBLIC_DEMO_ROOM=maya-bakery

# Agent service (avoid 8000 — often occupied)
AGENT_SERVICE_PORT=8765
AGENT_AUTONOMY_LIMIT_USD=1000
CASHIER_AUTO_PAY_LIMIT_USD=1000

# Stripe test mode (real-but-fake money)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Coinbase x402 (optional payment rail)
COINBASE_API_KEY=
X402_ENABLED=false

# Demo
DEMO_FALLBACK_REPLAY=true
SEED_PATH=./data/seed/bakery_ledger.json